class Rectangle
{
double length,base;
Rectangle()
{
length=5;
base=10;
}
Rectangle(double l,double b)
{
length=l;
base=b;
}
Rectangle(double len)
{
length=base=len;
}
void area()
{
System.out.println("Area of Rectangle=");
System.out.println(length*base);
}
}
class democons
{
public static void main(String arg[])
{
Rectangle r1=new Rectangle();
r1.area();
Rectangle r2=new Rectangle(100,200);
r2.area();
Rectangle r3=new Rectangle(20);
r3.area();
}
}
