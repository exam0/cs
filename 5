class strhand
{
public static void main(String args[])
{
String s1="jamal";
String s2="JAMAL";
String s3="muhamed";
System.out.println("Length of s3="+s3.length());
System.out.println("Uppercase of s3="+s3.toUpperCase());
System.out.println("Lowercase of s3="+s3.toLowerCase());
System.out.println("Concat of s1&s3="+s1.concat(s3));
System.out.println("Equal of s1&s2="+s1.equals(s2));
StringBuffer sb=new StringBuffer(s3);
System.out.println("Reverse of s3="+sb.reverse());
}
}
