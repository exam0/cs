import java.io.*;
class A extends Thread
{
Thread t;
A()
{
t = new Thread(this, " Demo Thread A");
System.out.println(t);
start();
}
public void run()
{
try
{
for (int i=0; i<5; i++)
{
System.out.println(" From A =" +i);
Thread.sleep(1000);
}
}
catch(Exception e)
{
System.out.println(e);
}
}
}
